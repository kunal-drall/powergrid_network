# PowerGrid Network Backend Configuration
# Copy this file to .env and fill in your values

# ============================================
# Blockchain Configuration
# ============================================
SUBSTRATE_RPC_URL=ws://127.0.0.1:9944
DEVICE_OWNER_SEED=//Alice

# ============================================
# Contract Addresses (fill after deployment)
# Run ./scripts/deploy-local.sh to get these
# ============================================
TOKEN_CONTRACT_ADDRESS=
REGISTRY_CONTRACT_ADDRESS=
GRID_SERVICE_CONTRACT_ADDRESS=
GOVERNANCE_CONTRACT_ADDRESS=

# ============================================
# Tapo Smart Plug Configuration
# Get IP from your router or Tapo app
# ============================================
TAPO_EMAIL=your-email@example.com
TAPO_PASSWORD=your-password
TAPO_DEVICE_IP=192.168.1.100

# ============================================
# Service Configuration
# ============================================
MONITORING_INTERVAL_SECONDS=30

# Stake amount in native units (12 decimals)
# 2 tokens = 2000000000000
STAKE_AMOUNT=2000000000000
