# PowerGrid Network Backend Configuration (example)
# Copy to .env and fill in real values. Do NOT commit secrets.

# ============================================
# Blockchain Configuration
# ============================================
SUBSTRATE_RPC_URL=ws://127.0.0.1:9944
DEVICE_OWNER_SEED=//Alice

# ============================================
# Contract Addresses (deployed)
# ============================================
TOKEN_CONTRACT_ADDRESS=replace_with_token_address
REGISTRY_CONTRACT_ADDRESS=replace_with_registry_address
GRID_SERVICE_CONTRACT_ADDRESS=replace_with_grid_service_address
GOVERNANCE_CONTRACT_ADDRESS=replace_with_governance_address

# ============================================
# Tapo Smart Plug Configuration
# Set USE_MOCK_TAPO=true to bypass hardware
# ============================================
TAPO_EMAIL=
TAPO_PASSWORD=
TAPO_DEVICE_IP=
USE_MOCK_TAPO=true
MOCK_TAPO_PROFILE=steady  # options: steady|bursty|idle

# ============================================
# Service Configuration
# ============================================
# Monitoring interval in seconds
MONITORING_INTERVAL=30
# Stake amount (choose one):
# - STAKE_AMOUNT_TOKENS: human-friendly tokens (will be converted using TOKEN_DECIMALS, default 12)
# - STAKE_AMOUNT_NATIVE: raw chain units (12 decimals)
STAKE_AMOUNT_TOKENS=1
#STAKE_AMOUNT_NATIVE=2000000000000
# Token decimals (defaults to 12 if omitted)
TOKEN_DECIMALS=12
